"""One-time copy of visualization likes/dislikes out of library.db into viz.db.

Default paths match StOMP:
  ~/.local/share/vibe/library.db
  ~/.local/share/vibe/viz.db

Usage:
  tools/split-viz-ratings
  tools/split-viz-ratings /path/to/library.db
  tools/split-viz-ratings /path/to/library.db /path/to/viz.db
"""

import os
import sqlite3
import sys


def data_dir():
    xdg = os.environ.get("XDG_DATA_HOME")
    if xdg:
        return os.path.join(xdg, "vibe")
    return os.path.join(os.path.expanduser("~"), ".local", "share", "vibe")


def main():
    src = sys.argv[1] if len(sys.argv) > 1 else os.path.join(data_dir(), "library.db")
    dst = sys.argv[2] if len(sys.argv) > 2 else os.path.join(os.path.dirname(src) or ".", "viz.db")

    if not os.path.isfile(src):
        print("No library database at %s" % src, file=sys.stderr)
        return 1

    os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)

    lib = sqlite3.connect(src)
    try:
        n = lib.execute(
            "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='viz_ratings'"
        ).fetchone()[0]
        if n == 0:
            print("No viz_ratings table in %s" % src)
            return 0
        rows = lib.execute("SELECT key, rating FROM viz_ratings").fetchall()
    except sqlite3.Error as e:
        print("Read failed: %s" % e, file=sys.stderr)
        return 1
    finally:
        lib.close()

    viz = sqlite3.connect(dst)
    try:
        viz.execute("PRAGMA journal_mode=WAL")
        viz.execute(
            "CREATE TABLE IF NOT EXISTS viz_ratings ("
            "  key TEXT PRIMARY KEY,"
            "  rating INTEGER NOT NULL"
            ")"
        )
        viz.executemany(
            "INSERT OR REPLACE INTO viz_ratings(key, rating) VALUES (?, ?)",
            rows,
        )
        viz.commit()
        total = viz.execute("SELECT COUNT(*) FROM viz_ratings").fetchone()[0]
    except sqlite3.Error as e:
        print("Write failed: %s" % e, file=sys.stderr)
        return 1
    finally:
        viz.close()

    print("Copied %d rating(s) from %s" % (len(rows), src))
    print("Visualization ratings now in %s (%d total)" % (dst, total))
    print("Safe to delete library.db; viz.db is independent.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
